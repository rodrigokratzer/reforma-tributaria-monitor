INLABS_EMAIL=
INLABS_SENHA=

# Alerta por push (ntfy.sh): topico aleatorio e secreto -- quem souber o nome le os alertas
NTFY_TOPICO=
# Servidor ntfy (opcional; vazio = https://ntfy.sh)
NTFY_SERVIDOR=

# Alerta por e-mail (SMTP com STARTTLS; no Gmail, usar senha de app). Vazio = e-mail desligado
SMTP_HOST=
# Porta SMTP (vazio = 587)
SMTP_PORTA=
SMTP_USUARIO=
SMTP_SENHA=
# Destinatarios, separados por virgula
EMAIL_PARA=

# Link do painel usado nos alertas (vazio = https://rodrigokratzer.github.io/reforma-tributaria-monitor/)
PAINEL_URL=
