[Unit]
Description=Alerta de falha da unidade %i (push/e-mail, com limite de tentativas)

[Service]
Type=oneshot
User=rodrigo
Group=rodrigo
Environment=HOME=/home/rodrigo
WorkingDirectory=/home/rodrigo/projects/reforma-tributaria-monitor
EnvironmentFile=-/home/rodrigo/projects/reforma-tributaria-monitor/.env
# Desde 23/11/2026: avisa na 1a falha seguida, cala as seguintes e, no limite
# (3, ou 12 no ciclo do robo), PAUSA o timer da rotina e manda o ultimo aviso.
# O "+" roda como root (parar timer exige root); o push sai como rodrigo.
ExecStart=+/home/rodrigo/projects/reforma-tributaria-monitor/.venv/bin/python3 scripts/limite_falhas.py %i
