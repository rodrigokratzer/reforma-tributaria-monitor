[Unit]
Description=Aviso de vencimento da chave de 1 ano do Claude no lenovo-claude
After=network-online.target
Wants=network-online.target
OnFailure=reforma-falha@%n.service

[Service]
Type=oneshot
User=rodrigo
Group=rodrigo
Environment=HOME=/home/rodrigo
WorkingDirectory=/home/rodrigo/projects/reforma-tributaria-monitor
EnvironmentFile=-/home/rodrigo/projects/reforma-tributaria-monitor/.env
ExecStart=/home/rodrigo/projects/reforma-tributaria-monitor/.venv/bin/python3 scripts/aviso_token_claude.py
